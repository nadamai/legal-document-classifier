  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "pretty-quick": "^4.2.2",
    "rolldown": "1.3.0",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
