{
  "name": "@hamurabi/legal-document-classifier",
  "version": "1.0.0",
  "description": "npm package for classifying webpage content as web legal documents",
  "license": "MIT",
  "author": "Hamurabi",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc && tsc -p tools",
    "build": "tsdown",
    "prepare": "husky",
    "prettier": "pretty-quick --staged --pattern \"{src,tools}/**/*.ts\"",
    "prettier:check": "prettier --check \"{src,tools}/**/*.ts\"",
    "scrape": "npm run build && training/.venv/bin/python training/scrape.py",
    "scrape:all": "npm run build && training/.venv/bin/python training/scrape_all.py",
    "train:setup": "sh training/setup.sh",
    "train": "training/.venv/bin/python training/train.py",
    "train:all": "training/.venv/bin/python training/train_all.py"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "pretty-quick": "^4.2.2",
    "rolldown": "1.3.0",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
