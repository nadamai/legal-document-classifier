{
  "name": "@hamurabi/legal-document-classifier",
  "version": "1.0.0",
  "description": "A simple logistic regression in your browser for classifying webpages as web legal documents",
  "keywords": [
    "legal",
    "legal-document",
    "terms-of-service",
    "terms-and-conditions",
    "privacy-policy",
    "cookie-policy",
    "classifier",
    "text-classification",
    "logistic-regression",
    "machine-learning",
    "zero-dependency",
    "browser",
    "dom",
    "hamurabi"
  ],
  "license": "MIT",
  "author": {
    "name": "Hamurabi",
    "url": "https://hamurabi.app"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/nadamai/legal-document-classifier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadamai/legal-document-classifier.git"
  },
  "scripts": {
    "typecheck": "tsc && tsc -p tools && tsc -p test",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "prettier": "pretty-quick --staged --pattern \"{src,tools,test}/**/*.ts\"",
    "prettier:check": "prettier --check \"{src,tools,test}/**/*.ts\"",
    "test": "npm run build && vitest run",
    "scrape": "npm run build && training/.venv/bin/python training/scrape.py",
    "scrape:all": "npm run build && training/.venv/bin/python training/scrape_all.py",
    "train:setup": "sh training/setup.sh",
    "train": "training/.venv/bin/python training/train.py",
    "train:all": "training/.venv/bin/python training/train_all.py",
    "evaluate": "training/.venv/bin/python training/evaluate.py"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "husky": "^9.1.7",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "pretty-quick": "^4.2.2",
    "rolldown": "1.3.0",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
