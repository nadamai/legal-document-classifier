{
  "name": "@hamurabi/legal-document-classifier",
  "version": "1.0.0",
  "description": "npm package for classifying webpage content as web legal documents",
  "license": "MIT",
  "author": "Hamurabi",
  "type": "module",
  "main": "index.ts",
  "scripts": {
